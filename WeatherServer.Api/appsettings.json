{
    /*
The following identity settings need to be configured
before the project can be successfully executed.
For more info see https://aka.ms/dotnet-template-ms-identity-platform
*/
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "TemperatureApiConfig": {
        "Inputs": {
            "Cities": [
                "bratislava",
                "praha",
                "budapest",
                "vieden"
            ]
        },
        "WeatherService": {
            "RequestUriTemplate": "https://api.openweathermap.org/data/2.5/weather?lat={lat}&lon={lon}&units=metric&lang=en&mode=json&appid={apiKey}",
            "ApiKeyEnvVar": "OPEN_WEATHER_MAP_ORG_API_KEY",
            "InputToApiInput": {
                "bratislava": {
                    "Lat": 48.1361,
                    "Lon": 17.1033
                },
                "praha": {
                    "Lat": 50.0860,
                    "Lon": 14.4206
                },
                "budapest": {
                    "Lat": 47.5021,
                    "Lon": 19.0410
                },
                "vieden": {
                    "Lat": 48.2081,
                    "Lon": 16.3729
                }
            },
            "TimeoutMS": 1000,
            "ResponseFormat": "json",
            "ApiResponseToResponse": {
                "Temperature": "$.main.temp",
                "MeasureTimeStamp": "$.dt",
                "MeasureTimeStampFormat": "unix-epoch"
            }
        },
        "Outputs": {
            "Temperature": {
                "Decimals": 2
            }
        }
    }
}
